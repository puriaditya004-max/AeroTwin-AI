# AeroTwin AI - Docker Compose environment template
# Copy to .env (same folder as docker-compose.yml) before running `docker compose up`.
# Never commit the real .env.

# --- Database ---
POSTGRES_USER=aerotwin
POSTGRES_PASSWORD=replace-with-a-real-password
POSTGRES_DB=aerotwin

# --- Control API ---
JWT_SECRET=replace-with-a-long-random-string
CORS_ORIGIN=http://localhost:5173

# --- Operator HMI ---
# Browser-side, so must be reachable from the HOST, not the Docker network —
# use the published port on localhost, not the "control-api" service name.
VITE_CONTROL_API_URL=http://localhost:4000
VITE_HMI_MODE=DEMO

# --- M2 Digital Twin Engine ---
M2_INPUT_STREAM=telemetry.frame.v1
M2_OUTPUT_STREAM=twin.state.v1
M2_CONSUMER_GROUP=m2-twin-engine
M2_CONSUMER_NAME=m2-worker-1
