# AeroTwin AI - Control API environment template
# Copy to .env and fill in real values. Never commit .env.

# --- Server ---
PORT=4000
NODE_ENV=development

# --- Database (PostgreSQL / TimescaleDB) ---
DATABASE_URL="postgresql://user:password@localhost:5432/aerotwin?schema=public"

# --- Auth ---
JWT_SECRET="replace-with-a-long-random-string"
JWT_EXPIRES_IN="1d"

# --- Redis (shared with M1/M2 for stream consumption, if control-api subscribes directly) ---
REDIS_URL="redis://localhost:6379"

# --- CORS ---
CORS_ORIGIN="http://localhost:5173"
